[
  {
    "id": "normal-case",
    "sku": "ABC123",
    "quantity": 1,
    "expected": {"http_status":200, "available": true, "quantity": 10, "note":"v1"},
    "description": "Normal case: v1 returns available true"
  },
  {
    "id": "boundary-zero",
    "sku": "OUTOFSTOCKZ",
    "quantity": 1,
    "expected": {"http_status":200, "available": false, "quantity": 0, "note":"v1"},
    "description": "Boundary: SKU that ends with Z mapped to zero quantity"
  },
  {
    "id": "malformed-sku",
    "sku": 12345,
    "quantity": 1,
    "expected": {"http_status":400},
    "description": "Malformed sku: not a string"
  },
  {
    "id": "v1-error",
    "sku": "ABCERR",
    "quantity": 2,
    "expected": {"http_status":502},
    "description": "Simulated upstream 500 -> service returns 502"
  },
  {
    "id": "high-latency",
    "sku": "SLOW1",
    "quantity": 1,
    "expected": {"http_status":504},
    "description": "High latency leading to timeout"
  }
]
