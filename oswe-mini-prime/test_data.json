[
  {
    "id": "normal-case",
    "sku": "ABC123",
    "quantity": 1,
    "regionId": "ap-sg-1",
    "warehouseGroup": "WG-1",
    "expected_pre": {"http_status":200, "available": true, "quantity": 10, "note":"v1"},
    "expected_post": {"http_status":200, "available": true, "quantity": 10, "note":"v2_confirmed"},
    "description": "Normal case: v2 returns confirmed availability immediately"
  },
  {
    "id": "boundary-zero",
    "sku": "OUTOFSTOCKZ",
    "quantity": 1,
    "regionId": "us-west-1",
    "warehouseGroup": "WG-2",
    "expected_pre": {"http_status":200, "available": false, "quantity": 0, "note":"v1"},
    "expected_post": {"http_status":200, "available": false, "quantity": 0, "note":"v2_confirmed"},
    "description": "Boundary: SKU that ends with Z mapped to zero quantity in v2"
  },
  {
    "id": "async-pending",
    "sku": "ASYNC1P",
    "quantity": 1,
    "regionId": "eu-de-1",
    "warehouseGroup": "WG-3",
    "expected_pre": {"http_status":200, "available": true, "quantity": 10, "note":"v1"},
    "expected_post": {"http_status":200, "available": true, "quantity": 10, "note":"v2_confirmed_after_poll"},
    "description": "Async pending: v2 returns pending then confirmed after polling"
  },
  {
    "id": "malformed-sku",
    "sku": 12345,
    "quantity": 1,
    "regionId": "ap-sg-1",
    "warehouseGroup": "WG-1",
    "expected_pre": {"http_status":400},
    "expected_post": {"http_status":400},
    "description": "Malformed sku: not a string"
  },
  {
    "id": "v2-error",
    "sku": "ABCERRE",
    "quantity": 2,
    "regionId": "ap-sg-1",
    "warehouseGroup": "WG-1",
    "expected_pre": {"http_status":200, "available": true, "quantity": 10, "note":"v1"},
    "expected_post": {"http_status":200, "available": true, "quantity": 10, "note":"v1_adapter"},
    "description": "v2 returns 500 -> v2 post-change should fallback to v1"
  }
]
